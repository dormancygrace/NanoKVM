#!/bin/sh

: "${NANOKVM_DISK:=/dev/mmcblk0}"
: "${NANOKVM_BOOT_PART:=/dev/mmcblk0p1}"
: "${NANOKVM_ROOT_PART:=/dev/mmcblk0p2}"
: "${NANOKVM_DATA_PART:=/dev/mmcblk0p3}"
: "${NANOKVM_BOOT_DIR:=/boot}"
: "${NANOKVM_DATA_DIR:=/data}"
: "${NANOKVM_DISK0_MARKER:=/etc/kvm.disk0}"
: "${NANOKVM_DATA_FORMAT_PENDING:=/etc/kvm.disk0.formatting}"
: "${NANOKVM_PROFILE:=/etc/profile}"
: "${NANOKVM_MOUNTS_FILE:=/proc/mounts}"
: "${NANOKVM_ROOT_START_FILE:=/sys/class/block/mmcblk0p2/start}"
: "${NANOKVM_ROOT_SIZE_FILE:=/sys/class/block/mmcblk0p2/size}"
: "${NANOKVM_ROOT_READY_MARKER:=/etc/kvm.rootfs-resized}"
: "${NANOKVM_ROOT_END_SECTOR:=16000000}"
: "${NANOKVM_PARTED:=parted}"
: "${NANOKVM_RESIZE2FS:=resize2fs}"

is_empty_partition() (
        tmp=$(mktemp "${TMPDIR:-/tmp}/s01fs-data-head.XXXXXX") || return 1
        trap 'rm -f "$tmp"' EXIT

        # Recover only legacy partitions that are provably empty. Unknown
        # non-empty partitions may contain user data and must never be erased.
        dd if="$1" of="$tmp" bs=1M count=4 2>/dev/null || return 1
        [ "$(wc -c < "$tmp")" != "0" ] || return 0
        od -An -tx1 "$tmp" | grep -q '[1-9a-fA-F]' && return 1
        return 0
)

data_partition_is_mounted() {
        [ -r "$NANOKVM_MOUNTS_FILE" ] || return 1
        awk -v device="$NANOKVM_DATA_PART" -v directory="$NANOKVM_DATA_DIR" '
                $1 == device && $2 == directory { found = 1 }
                END { exit !found }
        ' "$NANOKVM_MOUNTS_FILE"
}

format_and_mount_data_partition() {
        if data_partition_is_mounted
        then
                rm -f "$NANOKVM_DATA_FORMAT_PENDING"
                touch "$NANOKVM_DISK0_MARKER"
                return 0
        fi

        rm -f "$NANOKVM_DISK0_MARKER"
        if ! mkfs.exfat "$NANOKVM_DATA_PART"
        then
                # Keep the pending marker so the next boot retries.
                return 1
        fi

        rm -f "$NANOKVM_DATA_FORMAT_PENDING"
        mkdir -p "$NANOKVM_DATA_DIR" || return 1
        if mount "$NANOKVM_DATA_PART" "$NANOKVM_DATA_DIR"
        then
                touch "$NANOKVM_DISK0_MARKER"
                return 0
        fi

        return 1
}

normalize_disk_file() {
        printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

wait_for_data_partition() {
        elapsed=0
        while [ ! -e "$NANOKVM_DATA_PART" ] && [ "$elapsed" -lt 10 ]
        do
                sleep 1
                elapsed=$((elapsed + 1))
        done
        [ -e "$NANOKVM_DATA_PART" ]
}

prepare_data_filesystem() {
        data_mount_handled=0
        data_marker_after_mount=0
        disk0_file=

        if data_partition_is_mounted
        then
                rm -f "$NANOKVM_DATA_FORMAT_PENDING"
                touch "$NANOKVM_DISK0_MARKER"
                return 0
        fi

        if [ -e "$NANOKVM_BOOT_DIR/usb.disk0" ]
        then
                disk0_file=$(normalize_disk_file "$(cat "$NANOKVM_BOOT_DIR/usb.disk0")")
        fi

        # An empty usb.disk0 selects the built-in p3 data disk. A custom image
        # path must not create or repartition the default data disk.
        if [ -e "$NANOKVM_BOOT_DIR/usb.disk0" ] && \
                { [ -z "$disk0_file" ] || [ "$disk0_file" = "$NANOKVM_DATA_PART" ]; } && \
                [ ! -e "$NANOKVM_DATA_PART" ]
        then
                if parted -s "$NANOKVM_DISK" "mkpart primary 8193MB 100%"
                then
                        touch "$NANOKVM_DATA_FORMAT_PENDING"
                        wait_for_data_partition || true
                fi
        fi

        # Formatting is synchronous. The old background mkfs plus fixed
        # one-second sleep could race the mount and leave a false ready marker.
        if [ -e "$NANOKVM_DATA_PART" ] && [ -e "$NANOKVM_DATA_FORMAT_PENDING" ]
        then
                format_and_mount_data_partition || true
                data_mount_handled=1
        fi

        if [ -e "$NANOKVM_DATA_PART" ] && [ "$data_mount_handled" = "0" ]
        then
                if [ -n "$(blkid "$NANOKVM_DATA_PART" 2>/dev/null)" ]
                then
                        data_marker_after_mount=1
                elif [ -e "$NANOKVM_DISK0_MARKER" ] && is_empty_partition "$NANOKVM_DATA_PART"
                then
                        touch "$NANOKVM_DATA_FORMAT_PENDING"
                        format_and_mount_data_partition || true
                        data_mount_handled=1
                else
                        rm -f "$NANOKVM_DISK0_MARKER"
                        data_mount_handled=1
                fi
        fi

        if [ -e "$NANOKVM_DATA_PART" ] && [ "$data_mount_handled" = "0" ]
        then
                mkdir -p "$NANOKVM_DATA_DIR"
                if mount "$NANOKVM_DATA_PART" "$NANOKVM_DATA_DIR"
                then
                        [ "$data_marker_after_mount" = "0" ] || touch "$NANOKVM_DISK0_MARKER"
                elif [ "$data_marker_after_mount" = "1" ]
                then
                        rm -f "$NANOKVM_DISK0_MARKER"
                fi
        fi
}

read_uint_file() {
        value=$(cat "$1" 2>/dev/null) || return 1
        case "$value" in
                ''|*[!0-9]*) return 1 ;;
        esac
        printf '%s\n' "$value"
}

root_partition_end_sector() {
        start=$(read_uint_file "$NANOKVM_ROOT_START_FILE") || return 1
        size=$(read_uint_file "$NANOKVM_ROOT_SIZE_FILE") || return 1
        [ "$size" -gt 0 ] || return 1
        printf '%s\n' "$((start + size - 1))"
}

prepare_root_filesystem() {
        current_end=$(root_partition_end_sector) || {
                echo "Could not read root partition geometry; leaving it unchanged" >&2
                return 1
        }

        if [ "$current_end" -lt "$NANOKVM_ROOT_END_SECTOR" ]
        then
                # The official image starts with a 1.5 GiB root partition. Grow
                # it directly to the intended 8,192,000,000-byte boundary.
                # Do not extend it to the end of the card and shrink it back on
                # every boot: that needlessly rewrites the partition table and
                # can overlap an existing data partition after interruption.
                rm -f "$NANOKVM_ROOT_READY_MARKER"
                "$NANOKVM_PARTED" -s "$NANOKVM_DISK" unit s \
                        resizepart 2 "${NANOKVM_ROOT_END_SECTOR}s" || return 1
                current_end=$NANOKVM_ROOT_END_SECTOR
        elif [ "$current_end" -gt "$NANOKVM_ROOT_END_SECTOR" ]
        then
                # An interrupted legacy boot may have left p2 extended to the
                # end of the card. Never shrink a partition around a mounted
                # filesystem; keep the larger safe geometry instead.
                echo "root partition already extends beyond the default boundary; not shrinking it" >&2
        fi

        ready_end=$(read_uint_file "$NANOKVM_ROOT_READY_MARKER") || ready_end=
        if [ "$ready_end" != "$current_end" ]
        then
                # Run synchronously so an interrupted first boot retries before
                # claiming that the filesystem fills the resized partition.
                rm -f "$NANOKVM_ROOT_READY_MARKER"
                "$NANOKVM_RESIZE2FS" "$NANOKVM_ROOT_PART" || return 1
                printf '%s\n' "$current_end" > "$NANOKVM_ROOT_READY_MARKER" || return 1
        fi
}

if [ "${1:-}" = "start" ]
then
        prepare_root_filesystem || echo "root filesystem resize deferred" >&2


        if [ -r "$NANOKVM_PROFILE" ]
        then
                # shellcheck disable=SC1090
                . "$NANOKVM_PROFILE"
        fi
        printf "mounting filesystem : "
        mkdir -p "$NANOKVM_BOOT_DIR"
        mount -t vfat "$NANOKVM_BOOT_PART" "$NANOKVM_BOOT_DIR"
        mount -t configfs configfs /sys/kernel/config
        mount -t debugfs debugfs /sys/kernel/debug

        prepare_data_filesystem

        echo "OK"
fi
